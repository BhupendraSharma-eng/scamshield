# Tier 1 typed decisions: OpenAI Decisions API (gpt-6-luna). Same key powers the Tier 2 LLM audit.
OPENAI_API_KEY=sk-...
DECISION_PROVIDER=openai
DECISION_MODEL=gpt-6-luna
LLM_PROVIDER=openai
LLM_MODEL=gpt-5.6-luna

