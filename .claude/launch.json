{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "backend/.venv/bin/uvicorn",
      "runtimeArgs": [
        "app.main:app",
        "--app-dir",
        "backend",
        "--port",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "frontend/node_modules/.bin/vite",
      "runtimeArgs": [
        "frontend",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    }
  ]
}